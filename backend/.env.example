# Copiar como .env y completar.
# Sin ANTHROPIC_API_KEY la app funciona en "modo demo" (extracción por reglas).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# Desarrollo: SQLite. Producción: PostgreSQL gestionado (Supabase / Neon)
DATABASE_URL=sqlite:///./informeclaro.db
# DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/informeclaro

CORS_ORIGINS=["http://localhost:5173"]
